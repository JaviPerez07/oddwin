# Public base URL used for canonicals, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | test | staging | production
# In "production" development fixtures can never load, whatever else is set.
SITE_ENV=development

# Load fictional example.com casinos/offers to exercise the affiliate pipeline.
# Ignored when SITE_ENV=production.
AFFILIATE_TEST_FIXTURES=0

# Optional analytics endpoint that accepts POSTed JSON events. Leave empty to
# disable analytics entirely (no consent banner is shown).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Record events on window.__analyticsEvents (tests / local debugging only).
NEXT_PUBLIC_ANALYTICS_DEBUG=0

# Optional public contact address shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=
