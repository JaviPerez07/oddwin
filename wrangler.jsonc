{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oddwin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://oddwinstudios.com"
  }
}
